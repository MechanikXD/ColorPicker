<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ColorPicker.ViewModels"
             x:Class="ColorPicker.View.BottomNavBar"
             x:DataType="vm:BottomNavViewModel">

    <ContentView.Resources>
        <!-- Shared icon size -->
        <x:Double x:Key="NavIconSize">22</x:Double>
        <x:Double x:Key="NavFontSize">10</x:Double>
        <x:Double x:Key="NavBarHeight">64</x:Double>
    </ContentView.Resources>

    <!-- Outer grid lets the camera button overflow above the bar surface -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="24" />
            <RowDefinition Height="{StaticResource NavBarHeight}" />
        </Grid.RowDefinitions>

        <!-- Camera button sits in Row 0+1 (spans both) so it floats above the bar -->
        <Border Grid.Row="0" Grid.RowSpan="2"
                Grid.Column="0"
                WidthRequest="64" HeightRequest="64"
                StrokeShape="RoundRectangle 32"
                StrokeThickness="0"
                Background="{StaticResource AccentGradientBrush}"
                HorizontalOptions="Center"
                VerticalOptions="Start"
                ZIndex="10">
            <Border.Shadow>
                <Shadow Brush="{StaticResource Accent}"
                        Opacity="0.45"
                        Radius="16"
                        Offset="0,4" />
            </Border.Shadow>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding NavigateCommand}"
                                      CommandParameter="camera" />
            </Border.GestureRecognizers>

            <!-- Camera icon (use your icon font / image here) -->
            <Label Text="⬤"
                   FontSize="26"
                   TextColor="White"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
        </Border>

        <!-- Bar surface — sits in Row 1 -->
        <Border Grid.Row="1"
                BackgroundColor="{AppThemeBinding Light={StaticResource LightCard}, Dark={StaticResource DarkCard}}"
                StrokeThickness="0">
            <Border.Shadow>
                <Shadow Brush="Black" Opacity="0.08" Radius="12" Offset="0,-4" />
            </Border.Shadow>

            <!--
                5 columns: [Main] [Palettes] [Camera placeholder] [History] [Settings]
                The center column is an invisible spacer so items surround the camera bubble.
            -->
            <Grid ColumnDefinitions="*,*,80,*,*"
                  HeightRequest="{StaticResource NavBarHeight}">

                <!-- Main / Dashboard -->
                <VerticalStackLayout Grid.Column="0" Spacing="2"
                                     VerticalOptions="Center" HorizontalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateCommand}"
                                              CommandParameter="main" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="⊞"
                           FontSize="{StaticResource NavIconSize}"
                           HorizontalOptions="Center"
                           TextColor="{Binding ActiveRoute, Converter={StaticResource RouteToColorConverter}, ConverterParameter=main}" />
                    <Label Text="Home"
                           FontSize="{StaticResource NavFontSize}"
                           HorizontalOptions="Center"
                           TextColor="{Binding ActiveRoute, Converter={StaticResource RouteToColorConverter}, ConverterParameter=main}" />
                    <!-- Active dot -->
                    <BoxView WidthRequest="4" HeightRequest="4"
                             CornerRadius="2"
                             Color="{StaticResource Accent}"
                             HorizontalOptions="Center"
                             IsVisible="{Binding ActiveRoute, Converter={StaticResource RouteMatchConverter}, ConverterParameter=main}" />
                </VerticalStackLayout>

                <!-- Palettes -->
                <VerticalStackLayout Grid.Column="1" Spacing="2"
                                     VerticalOptions="Center" HorizontalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateCommand}"
                                              CommandParameter="palettes" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="▦"
                           FontSize="{StaticResource NavIconSize}"
                           HorizontalOptions="Center"
                           TextColor="{Binding ActiveRoute, Converter={StaticResource RouteToColorConverter}, ConverterParameter=palettes}" />
                    <Label Text="Palettes"
                           FontSize="{StaticResource NavFontSize}"
                           HorizontalOptions="Center"
                           TextColor="{Binding ActiveRoute, Converter={StaticResource RouteToColorConverter}, ConverterParameter=palettes}" />
                    <BoxView WidthRequest="4" HeightRequest="4" CornerRadius="2"
                             Color="{StaticResource Accent}" HorizontalOptions="Center"
                             IsVisible="{Binding ActiveRoute, Converter={StaticResource RouteMatchConverter}, ConverterParameter=palettes}" />
                </VerticalStackLayout>

                <!-- Column 2: empty spacer — camera bubble floats over it -->
                <BoxView Grid.Column="2" Color="Transparent" />

                <!-- History -->
                <VerticalStackLayout Grid.Column="3" Spacing="2"
                                     VerticalOptions="Center" HorizontalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateCommand}"
                                              CommandParameter="history" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="◷"
                           FontSize="{StaticResource NavIconSize}"
                           HorizontalOptions="Center"
                           TextColor="{Binding ActiveRoute, Converter={StaticResource RouteToColorConverter}, ConverterParameter=history}" />
                    <Label Text="History"
                           FontSize="{StaticResource NavFontSize}"
                           HorizontalOptions="Center"
                           TextColor="{Binding ActiveRoute, Converter={StaticResource RouteToColorConverter}, ConverterParameter=history}" />
                    <BoxView WidthRequest="4" HeightRequest="4" CornerRadius="2"
                             Color="{StaticResource Accent}" HorizontalOptions="Center"
                             IsVisible="{Binding ActiveRoute, Converter={StaticResource RouteMatchConverter}, ConverterParameter=history}" />
                </VerticalStackLayout>

                <!-- Settings -->
                <VerticalStackLayout Grid.Column="4" Spacing="2"
                                     VerticalOptions="Center" HorizontalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateCommand}"
                                              CommandParameter="settings" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="⚙"
                           FontSize="{StaticResource NavIconSize}"
                           HorizontalOptions="Center"
                           TextColor="{Binding ActiveRoute, Converter={StaticResource RouteToColorConverter}, ConverterParameter=settings}" />
                    <Label Text="Settings"
                           FontSize="{StaticResource NavFontSize}"
                           HorizontalOptions="Center"
                           TextColor="{Binding ActiveRoute, Converter={StaticResource RouteToColorConverter}, ConverterParameter=settings}" />
                    <BoxView WidthRequest="4" HeightRequest="4" CornerRadius="2"
                             Color="{StaticResource Accent}" HorizontalOptions="Center"
                             IsVisible="{Binding ActiveRoute, Converter={StaticResource RouteMatchConverter}, ConverterParameter=settings}" />
                </VerticalStackLayout>

            </Grid>
        </Border>

    </Grid>
</ContentView>
