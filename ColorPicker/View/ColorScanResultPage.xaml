<?xml version="1.0" encoding="UTF-8" ?>
<colorPicker:AnimatedPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:v="clr-namespace:ColorPicker.View"
             xmlns:vm="clr-namespace:ColorPicker.ViewModels"
             xmlns:colorPicker="clr-namespace:ColorPicker"
             x:Class="ColorPicker.View.ColorScanResultPage"
             x:DataType="vm:ColorScanResultViewModel"
             Shell.NavBarIsVisible="False">

    <!--
        Layout:
          Row 0 (*) : scrollable content (photo, color chip, sliders)
          Row 1 (Auto): BottomNavBar
        ColorCombinationsPanel overlays Row 0 + Row 1, pinned to bottom
        above the nav bar via a bottom margin equal to the nav bar height.
    -->
    <Grid RowDefinitions="*, Auto">

        <!-- SCROLLABLE BODY -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="0">

                <!-- Top action bar -->
                <Grid ColumnDefinitions="Auto, *, Auto"
                      Padding="16,52,16,8">

                    <Button Grid.Column="0"
                            Text="← Retake"
                            Style="{StaticResource OutlineButtonStyle}"
                            HeightRequest="38"
                            Command="{Binding RetakeCommand}" />

                    <Label Grid.Column="1"
                           Text="Scanned Color"
                           Style="{StaticResource TitleLabelStyle}"
                           FontSize="17"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />

                    <Button Grid.Column="2"
                            Text="Save"
                            Style="{StaticResource AccentButtonStyle}"
                            HeightRequest="38" WidthRequest="72"
                            Command="{Binding SaveToPaletteCommand}" />
                </Grid>

                <!-- Captured photo -->
                <!--
                    Shows the image taken by the camera.
                    Aspect="AspectFill" crops it to fill the fixed height.
                    A subtle vignette overlay darkens the edges to keep the
                    sampled-color panel below readable at any photo content.
                -->
                <Grid HeightRequest="260" Margin="0,8,0,0">

                    <Image Source="{Binding ScannedImageSource}"
                           Aspect="AspectFill"
                           HorizontalOptions="Fill"
                           VerticalOptions="Fill" />

                    <!-- Bottom fade gradient overlay -->
                    <BoxView VerticalOptions="End"
                             HeightRequest="80"
                             HorizontalOptions="Fill">
                        <BoxView.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="Transparent" Offset="0" />
                                <GradientStop Color="{AppThemeBinding Light=#F7F6FB,
                                                                       Dark=#121018}"
                                              Offset="1" />
                            </LinearGradientBrush>
                        </BoxView.Background>
                    </BoxView>

                    <!-- Center reticle marker (shows where the color was sampled) -->
                    <Border WidthRequest="40" HeightRequest="40"
                            StrokeShape="Ellipse"
                            Stroke="White" StrokeThickness="2"
                            BackgroundColor="Transparent"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                        <Border.Shadow>
                            <Shadow Brush="Black" Opacity="0.5" Radius="8" Offset="0,0" />
                        </Border.Shadow>
                    </Border>
                </Grid>

                <!-- Sampled color chip -->
                <Border Style="{StaticResource CardStyle}"
                        Margin="16,0,16,0">
                    <Grid ColumnDefinitions="64, *, Auto" ColumnSpacing="14">

                        <!-- Color swatch -->
                        <Border Grid.Column="0"
                                WidthRequest="56" HeightRequest="56"
                                StrokeShape="RoundRectangle 14"
                                StrokeThickness="2"
                                Stroke="{AppThemeBinding Light={StaticResource LightBorder},
                                                          Dark={StaticResource DarkBorder}}"
                                BackgroundColor="{Binding SampledColor}">
                            <Border.Shadow>
                                <Shadow Brush="{Binding SampledColor}"
                                        Opacity="0.4" Radius="12" Offset="0,4" />
                            </Border.Shadow>
                        </Border>

                        <!-- Hex + label -->
                        <VerticalStackLayout Grid.Column="1"
                                             VerticalOptions="Center"
                                             Spacing="3">
                            <Label Text="Sampled Color"
                                   Style="{StaticResource BodyLabelStyle}"
                                   FontSize="11" />
                            <Label Text="{Binding HexValue}"
                                   FontSize="20"
                                   FontFamily="Monospace"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary},
                                                               Dark={StaticResource DarkTextPrimary}}" />
                        </VerticalStackLayout>

                        <!-- Copy hex button -->
                        <Border Grid.Column="2"
                                WidthRequest="40" HeightRequest="40"
                                StrokeShape="RoundRectangle 10"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource LightBorder},
                                                          Dark={StaticResource DarkBorder}}"
                                BackgroundColor="Transparent"
                                VerticalOptions="Center">
                            <Label Text="⎘"
                                   FontSize="18"
                                   TextColor="{StaticResource Accent}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Adjustment sliders -->
                <Border Style="{StaticResource CardStyle}"
                        Margin="16,12,16,0">
                    <VerticalStackLayout Spacing="18">

                        <Label Text="Adjust"
                               FontAttributes="Bold"
                               FontSize="15"
                               TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary},
                                                           Dark={StaticResource DarkTextPrimary}}" />

                        <!-- Brightness -->
                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Text="Brightness"
                                       Style="{StaticResource BodyLabelStyle}" />
                                <Label Grid.Column="1"
                                       Text="{Binding Brightness, StringFormat='{0:F0}'}"
                                       Style="{StaticResource BodyLabelStyle}" />
                            </Grid>
                            <Slider Minimum="0" Maximum="100"
                                    Value="{Binding Brightness}"
                                    MinimumTrackColor="{StaticResource Accent}"
                                    MaximumTrackColor="{AppThemeBinding Light={StaticResource LightBorder},
                                                                        Dark={StaticResource DarkBorder}}"
                                    ThumbColor="{StaticResource Accent}" />
                        </VerticalStackLayout>

                        <!-- Contrast -->
                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Text="Contrast"
                                       Style="{StaticResource BodyLabelStyle}" />
                                <Label Grid.Column="1"
                                       Text="{Binding Contrast, StringFormat='{0:F0}'}"
                                       Style="{StaticResource BodyLabelStyle}" />
                            </Grid>
                            <Slider Minimum="0" Maximum="100"
                                    Value="{Binding Contrast}"
                                    MinimumTrackColor="{StaticResource Accent}"
                                    MaximumTrackColor="{AppThemeBinding Light={StaticResource LightBorder},
                                                                        Dark={StaticResource DarkBorder}}"
                                    ThumbColor="{StaticResource Accent}" />
                        </VerticalStackLayout>

                        <!-- Saturation -->
                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Text="Saturation"
                                       Style="{StaticResource BodyLabelStyle}" />
                                <Label Grid.Column="1"
                                       Text="{Binding Saturation, StringFormat='{0:F0}'}"
                                       Style="{StaticResource BodyLabelStyle}" />
                            </Grid>
                            <Slider Minimum="0" Maximum="100"
                                    Value="{Binding Saturation}"
                                    MinimumTrackColor="{StaticResource Accent}"
                                    MaximumTrackColor="{AppThemeBinding Light={StaticResource LightBorder},
                                                                        Dark={StaticResource DarkBorder}}"
                                    ThumbColor="{StaticResource Accent}" />
                        </VerticalStackLayout>

                        <!-- RGB divider -->
                        <BoxView HeightRequest="1"
                                 Color="{AppThemeBinding Light={StaticResource LightBorder},
                                                          Dark={StaticResource DarkBorder}}" />

                        <!-- Red -->
                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Text="Red"
                                       Style="{StaticResource BodyLabelStyle}" />
                                <Label Grid.Column="1"
                                       Text="{Binding Red, StringFormat='{0:F0}'}"
                                       Style="{StaticResource BodyLabelStyle}" />
                            </Grid>
                            <Slider Minimum="0" Maximum="255"
                                    Value="{Binding Red}"
                                    MinimumTrackColor="#EF4444"
                                    MaximumTrackColor="{AppThemeBinding Light={StaticResource LightBorder},
                                                                        Dark={StaticResource DarkBorder}}"
                                    ThumbColor="#EF4444" />
                        </VerticalStackLayout>

                        <!-- Green -->
                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Text="Green"
                                       Style="{StaticResource BodyLabelStyle}" />
                                <Label Grid.Column="1"
                                       Text="{Binding Green, StringFormat='{0:F0}'}"
                                       Style="{StaticResource BodyLabelStyle}" />
                            </Grid>
                            <Slider Minimum="0" Maximum="255"
                                    Value="{Binding Green}"
                                    MinimumTrackColor="#22C55E"
                                    MaximumTrackColor="{AppThemeBinding Light={StaticResource LightBorder},
                                                                        Dark={StaticResource DarkBorder}}"
                                    ThumbColor="#22C55E" />
                        </VerticalStackLayout>

                        <!-- Blue -->
                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Text="Blue"
                                       Style="{StaticResource BodyLabelStyle}" />
                                <Label Grid.Column="1"
                                       Text="{Binding Blue, StringFormat='{0:F0}'}"
                                       Style="{StaticResource BodyLabelStyle}" />
                            </Grid>
                            <Slider Minimum="0" Maximum="255"
                                    Value="{Binding Blue}"
                                    MinimumTrackColor="#3B82F6"
                                    MaximumTrackColor="{AppThemeBinding Light={StaticResource LightBorder},
                                                                        Dark={StaticResource DarkBorder}}"
                                    ThumbColor="#3B82F6" />
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <!--
                    Bottom spacer so the last slider isn't hidden behind the
                    ColorCombinationsPanel peek + BottomNavBar when fully scrolled.
                    Height = panel peek height (108) + nav bar height (64) + padding (16).
                -->
                <BoxView HeightRequest="188" Color="Transparent" />

            </VerticalStackLayout>
        </ScrollView>

        <v:ColorCombinationsPanel
            Grid.Row="0" Grid.RowSpan="2"
            BindingContext="{Binding CombinationsPanel}"
            VerticalOptions="End"
            Margin="0,0,0,64" />
        
        <!-- BottomNavBar -->
        <v:BottomNavBar Grid.Row="1" />
        
        <v:PromptView Grid.Row="0"
                      Grid.RowSpan="2"
                      BindingContext="{Binding Prompt}" />
    </Grid>
</colorPicker:AnimatedPage>
