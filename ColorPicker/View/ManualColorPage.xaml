<?xml version="1.0" encoding="UTF-8" ?>
<colorPicker:AnimatedPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ColorPicker.ViewModels"
             xmlns:v="clr-namespace:ColorPicker.View"
             xmlns:c="clr-namespace:ColorPicker.Services.Converters"
             xmlns:colorPicker="clr-namespace:ColorPicker"
             xmlns:text="clr-namespace:ColorPicker.Services.Theme"
             xmlns:localization="clr-namespace:ColorPicker.Services.Localization"
             x:Class="ColorPicker.View.ManualColorPage"
             x:DataType="vm:ManualColorViewModel"
             x:Name="ThisPage"
             Shell.NavBarIsVisible="False">
    <!--
        Non-tab page: navigating away via BottomNavBar acts as Cancel.
        The nav bar is shown (visible) but tapping any tab invokes CancelCommand
        first before routing, handled in BottomNavViewModel.
    -->

    <colorPicker:AnimatedPage.Resources>
        <c:RouteToColorConverter x:Key="InverseBoolConverter" />
        <!-- Value readout chip style - displays metric name + value -->
        <Style x:Key="ValueChipStyle" TargetType="Border">
            <Setter Property="StrokeShape" Value="RoundRectangle 10" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Stroke"
                    Value="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}" />
            <Setter Property="BackgroundColor"
                    Value="{AppThemeBinding Light={StaticResource LightCard}, Dark={StaticResource DarkCard}}" />
            <Setter Property="Padding" Value="10,6" />
        </Style>
    </colorPicker:AnimatedPage.Resources>

    <!--
        Root Grid:
          Row 0  = top bar (cancel + confirm actions)
          Row 1  = large color preview
          Row 2  = value readout chips
          Row 3  = slider section (scrollable)
          Row 4  = nav bar (always visible)
        ColorCombinationsPanel overlays Rows 2-4 as an AbsoluteLayout layer.
    -->
    <Grid RowDefinitions="56, 200, Auto, *, Auto">

        <!-- Top action bar -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Padding="16,8">
            <Button Grid.Column="0"
                    Text="{localization:Translate button_cancel}"
                    Style="{StaticResource OutlineButtonStyle}"
                    HeightRequest="38"
                    Command="{Binding CancelCommand}" />

            <Label Grid.Column="1"
                   Text="{Binding PageTitle}"
                   Style="{StaticResource TitleLabelStyle}"
                   FontSize="18"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />

            <!-- Add mode: "Add" button saves to palette -->
            <Button Grid.Column="2"
                    Text="{localization:Translate button_add}"
                    Style="{StaticResource AccentButtonStyle}"
                    HeightRequest="38" WidthRequest="80"
                    IsVisible="{Binding IsEditMode,
                                Converter={StaticResource InverseBoolConverter}}"
                    Command="{Binding AddToPaletteCommand}" />

            <!-- Edit mode: "Save" button confirms the change -->
            <Button Grid.Column="2"
                    Text="{localization:Translate button_save}"
                    Style="{StaticResource AccentButtonStyle}"
                    HeightRequest="38" WidthRequest="80"
                    IsVisible="{Binding IsEditMode}"
                    Command="{Binding ConfirmEditCommand}" />
        </Grid>

        <!-- Large color preview -->
        <!--
            Fills Row 1. Background is bound to CurrentColor.
            Tapping copies HEX to clipboard (via CopyHexCommand).
            The HEX label is overlaid with contrasting text color
            (use a brightness converter to auto-switch white/black).
        -->
        <Border Grid.Row="1"
                BackgroundColor="{Binding CurrentColor}"
                Margin="20,8"
                StrokeShape="RoundRectangle 24"
                StrokeThickness="0">
            <Border.Shadow>
                <Shadow Brush="{Binding CurrentColor}"
                        Opacity="0.35"
                        Radius="20"
                        Offset="0,6" />
            </Border.Shadow>

            <Grid>
                <!-- HEX overlay label -->
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="4">
                    <Label Text="{Binding HexInput}"
                           FontSize="22" FontAttributes="Bold"
                           FontFamily="Monospace"
                           TextColor="White"
                           HorizontalOptions="Center"
                           Opacity="0.9" />
                    <Label Text="{localization:Translate m_color_copy}"
                           FontSize="11"
                           TextColor="White"
                           HorizontalOptions="Center"
                           Opacity="0.6" />
                </VerticalStackLayout>

                <!-- Tap to copy gesture -->
                <Border BackgroundColor="Transparent"
                        StrokeThickness="0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CopyHexCommand}" />
                    </Border.GestureRecognizers>
                </Border>
            </Grid>
        </Border>

        <!-- Color value readout chips -->
        <ScrollView Grid.Row="2" Orientation="Horizontal"
                    Padding="20,0,20,12" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout Spacing="8">

                <!-- HEX -->
                <Border Style="{StaticResource ValueChipStyle}">
                    <VerticalStackLayout Spacing="1">
                        <Label Text="HEX" FontSize="9"
                               Style="{StaticResource BodyLabelStyle}" />
                        <Label Text="{Binding HexInput}"
                               FontSize="13" FontFamily="Monospace" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary},
                                                           Dark={StaticResource DarkTextPrimary}}" />
                    </VerticalStackLayout>
                </Border>

                <!-- RGB -->
                <Border Style="{StaticResource ValueChipStyle}">
                    <VerticalStackLayout Spacing="1">
                        <Label Text="RGB" FontSize="9" Style="{StaticResource BodyLabelStyle}" />
                        <Label FontSize="13" FontFamily="Monospace" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary},
                                                           Dark={StaticResource DarkTextPrimary}}">
                            <Label.Text>
                                <MultiBinding StringFormat="{}{0}, {1}, {2}">
                                    <Binding Path="Red" StringFormat="{}{0:F0}" />
                                    <Binding Path="Green" StringFormat="{}{0:F0}" />
                                    <Binding Path="Blue" StringFormat="{}{0:F0}" />
                                </MultiBinding>
                            </Label.Text>
                        </Label>
                    </VerticalStackLayout>
                </Border>

                <!-- HSV -->
                <Border Style="{StaticResource ValueChipStyle}">
                    <VerticalStackLayout Spacing="1">
                        <Label Text="HSV" FontSize="9" Style="{StaticResource BodyLabelStyle}" />
                        <Label FontSize="13" FontFamily="Monospace" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary},
                                                           Dark={StaticResource DarkTextPrimary}}">
                            <Label.Text>
                                <MultiBinding StringFormat="{}{0}°  {1}  {2}">
                                    <Binding Path="Hue" StringFormat="{}{0:F0}" />
                                    <Binding Path="Saturation" StringFormat="{}{0:P0}" />
                                    <Binding Path="Value" StringFormat="{}{0:P0}" />
                                </MultiBinding>
                            </Label.Text>
                        </Label>
                    </VerticalStackLayout>
                </Border>

            </HorizontalStackLayout>
        </ScrollView>

        <!-- Sliders -->
        <ScrollView Grid.Row="3" Padding="20,0,20,120">
            <VerticalStackLayout Spacing="20">

                <!-- HSV group -->
                <Border Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="16">
                        <Label Text="HSV" FontAttributes="Bold" FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary},
                                                           Dark={StaticResource DarkTextPrimary}}" />

                        <!-- Hue -->
                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{localization:Translate value_hue}" Style="{StaticResource BodyLabelStyle}" />
                                <Label Grid.Column="1"
                                       Text="{Binding Hue, StringFormat='{0:F0}°'}"
                                       Style="{StaticResource BodyLabelStyle}" />
                            </Grid>
                            <Slider Minimum="0" Maximum="360"
                                    Value="{Binding Hue}"
                                    MinimumTrackColor="{StaticResource Accent}"
                                    MaximumTrackColor="{AppThemeBinding Light={StaticResource LightBorder},
                                                                        Dark={StaticResource DarkBorder}}"
                                    ThumbColor="{StaticResource Accent}" />
                        </VerticalStackLayout>

                        <!-- Saturation -->
                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{localization:Translate value_saturation}" Style="{StaticResource BodyLabelStyle}" />
                                <Label Grid.Column="1"
                                       Text="{Binding Saturation, StringFormat='{0:P0}'}"
                                       Style="{StaticResource BodyLabelStyle}" />
                            </Grid>
                            <Slider Minimum="0" Maximum="1"
                                    Value="{Binding Saturation}"
                                    MinimumTrackColor="{StaticResource Accent}"
                                    MaximumTrackColor="{AppThemeBinding Light={StaticResource LightBorder},
                                                                        Dark={StaticResource DarkBorder}}"
                                    ThumbColor="{StaticResource Accent}" />
                        </VerticalStackLayout>

                        <!-- Value (brightness in HSV) -->
                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{localization:Translate value_value}" Style="{StaticResource BodyLabelStyle}" />
                                <Label Grid.Column="1"
                                       Text="{Binding Value, StringFormat='{0:P0}'}"
                                       Style="{StaticResource BodyLabelStyle}" />
                            </Grid>
                            <Slider Minimum="0" Maximum="1"
                                    Value="{Binding Value}"
                                    MinimumTrackColor="{StaticResource Accent}"
                                    MaximumTrackColor="{AppThemeBinding Light={StaticResource LightBorder},
                                                                        Dark={StaticResource DarkBorder}}"
                                    ThumbColor="{StaticResource Accent}" />
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <!-- RGB group -->
                <Border Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="16">
                        <Label Text="RGB" FontAttributes="Bold" FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary},
                                                           Dark={StaticResource DarkTextPrimary}}" />

                        <!-- Red -->
                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{localization:Translate value_red}" Style="{StaticResource BodyLabelStyle}" />
                                <Label Grid.Column="1"
                                       Text="{Binding Red, StringFormat='{0:F0}'}"
                                       Style="{StaticResource BodyLabelStyle}" />
                            </Grid>
                            <Slider Minimum="0" Maximum="255" Value="{Binding Red}"
                                    MinimumTrackColor="#EF4444"
                                    ThumbColor="#EF4444" />
                        </VerticalStackLayout>

                        <!-- Green -->
                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{localization:Translate value_green}" Style="{StaticResource BodyLabelStyle}" />
                                <Label Grid.Column="1"
                                       Text="{Binding Green, StringFormat='{0:F0}'}"
                                       Style="{StaticResource BodyLabelStyle}" />
                            </Grid>
                            <Slider Minimum="0" Maximum="255" Value="{Binding Green}"
                                    MinimumTrackColor="#22C55E"
                                    ThumbColor="#22C55E" />
                        </VerticalStackLayout>

                        <!-- Blue -->
                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{localization:Translate value_blue}" Style="{StaticResource BodyLabelStyle}" />
                                <Label Grid.Column="1"
                                       Text="{Binding Blue, StringFormat='{0:F0}'}"
                                       Style="{StaticResource BodyLabelStyle}" />
                            </Grid>
                            <Slider Minimum="0" Maximum="255" Value="{Binding Blue}"
                                    MinimumTrackColor="#3B82F6"
                                    ThumbColor="#3B82F6" />
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!--
            ColorCombinationsPanel (overlay layer)
            Anchored to the bottom, above the nav bar.
        -->
        <Grid Grid.Row="3" Grid.RowSpan="2"
              IsVisible="{Binding ShowCombinationsPanel}"
              VerticalOptions="End"
              Margin="0,0,0,64">
    
            <v:ColorCombinationsPanel BindingContext="{Binding CombinationsPanel}" />
        </Grid>
        
        <!-- Persistent nav bar -->
        <v:BottomNavBar Grid.Row="4" />
        
        <v:PromptView Grid.Row="0"
                      Grid.RowSpan="5"
                      BindingContext="{Binding Prompt}" />
    </Grid>
</colorPicker:AnimatedPage>
