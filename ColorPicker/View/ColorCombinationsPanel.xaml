<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ColorPicker.ViewModels"
             xmlns:m="clr-namespace:ColorPicker.Models.Colors"
             x:Class="ColorPicker.View.ColorCombinationsPanel"
             x:DataType="vm:ColorCombinationsPanelViewModel"
             VerticalOptions="End">
    
    <!-- Panel surface with top-only rounded corners -->
    <Border BackgroundColor="{AppThemeBinding Light={StaticResource LightCard},
                                               Dark={StaticResource DarkCard}}"
            StrokeThickness="1"
            Stroke="{AppThemeBinding Light={StaticResource LightBorder},
                                      Dark={StaticResource DarkBorder}}"
            StrokeShape="RoundRectangle 24,24,0,0">
        <Border.Shadow>
            <Shadow Brush="Black" Opacity="0.14" Radius="20" Offset="0,-6" />
        </Border.Shadow>

        <VerticalStackLayout Spacing="0">

            <!-- HANDLE STRIP — always visible, 52dp, sole collapsed state.
                 Tap anywhere on it to toggle open/close. -->
            <Grid HeightRequest="52"
                  ColumnDefinitions="*, Auto"
                  Padding="20,0">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleExpandCommand}" />
                </Grid.GestureRecognizers>

                <VerticalStackLayout Grid.Column="0"
                                     Spacing="4"
                                     VerticalOptions="Center">
                    <!-- Drag pill -->
                    <BoxView WidthRequest="36" HeightRequest="4"
                             CornerRadius="2"
                             Color="{AppThemeBinding Light={StaticResource LightBorder},
                                                      Dark={StaticResource DarkBorder}}"
                             HorizontalOptions="Start" />
                    <Label Text="Color Combinations"
                           FontSize="13" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary},
                                                       Dark={StaticResource DarkTextPrimary}}" />
                </VerticalStackLayout>

                <!-- ∨ when closed, ∧ when open -->
                <Label Grid.Column="1"
                       Text="{Binding IsExpanded,
                              Converter={StaticResource BoolToChevronConverter}}"
                       FontSize="16"
                       TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary},
                                                   Dark={StaticResource DarkTextSecondary}}"
                       VerticalOptions="Center" />
            </Grid>

            <!-- CONTENT — removed from layout entirely when collapsed.
                 IsVisible="False" means zero height, zero render cost,
                 and no accidental bleed-through into the closed state. -->
            <Grid RowDefinitions="Auto, *"
                  x:Name="ContentArea">

                <!-- Refresh bar -->
                <Grid Grid.Row="0"
                      ColumnDefinitions="*, Auto"
                      Padding="20,8,20,8">

                    <Label Grid.Column="0"
                           Text="{Binding Combinations.Count,
                                  StringFormat='{0} combination(s) found'}"
                           Style="{StaticResource BodyLabelStyle}"
                           FontSize="12"
                           VerticalOptions="Center" />

                    <Button Grid.Column="1"
                            Text="Refresh"
                            Style="{StaticResource OutlineButtonStyle}"
                            HeightRequest="32" WidthRequest="80"
                            FontSize="12"
                            Command="{Binding RefreshCommand}" />
                </Grid>

                <!-- Loading indicator -->
                <ActivityIndicator Grid.Row="1"
                                   IsRunning="{Binding IsLoading}"
                                   IsVisible="{Binding IsLoading}"
                                   Color="{StaticResource Accent}"
                                   HeightRequest="48" />

                <!-- Combination cards (hidden while loading) -->
                <ScrollView Grid.Row="1"
                            MaximumHeightRequest="420"
                            Padding="16,0,16,20"
                            IsVisible="{Binding IsLoading,
                                        Converter={StaticResource InverseBoolConverter}}">
                    <VerticalStackLayout Spacing="12"
                                         BindableLayout.ItemsSource="{Binding Combinations}">

                        <BindableLayout.EmptyView>
                            <Label Text="No matching combinations found in your palette."
                                   Style="{StaticResource BodyLabelStyle}"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"
                                   Padding="0,16" />
                        </BindableLayout.EmptyView>

                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="m:ColorCombination">

                                <Border StrokeShape="RoundRectangle 16"
                                        StrokeThickness="1"
                                        Stroke="{AppThemeBinding Light={StaticResource LightBorder},
                                                                  Dark={StaticResource DarkBorder}}"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground},
                                                                           Dark={StaticResource DarkBackground}}"
                                        Padding="14,12">

                                    <VerticalStackLayout Spacing="10">

                                        <!-- Ratio row: [Color1] Ratio1 ─+─ Ratio2 [Color2] -->
                                        <Grid ColumnDefinitions="48, Auto, *, Auto, 48"
                                              ColumnSpacing="8">

                                            <Border Grid.Column="0"
                                                    WidthRequest="44" HeightRequest="44"
                                                    StrokeShape="RoundRectangle 10"
                                                    StrokeThickness="2"
                                                    Stroke="{AppThemeBinding Light={StaticResource LightBorder},
                                                                              Dark={StaticResource DarkBorder}}"
                                                    BackgroundColor="{Binding FirstColor.ToColor}">
                                                <Border.Shadow>
                                                    <Shadow Brush="{Binding FirstColor.ToColor}"
                                                            Opacity="0.25" Radius="6" Offset="0,2" />
                                                </Border.Shadow>
                                            </Border>

                                            <Label Grid.Column="1"
                                                   Text="{Binding FirstColorRatio, StringFormat='{0:P0}'}"
                                                   FontSize="13" FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary},
                                                                               Dark={StaticResource DarkTextPrimary}}"
                                                   VerticalOptions="Center" />

                                            <Grid Grid.Column="2" VerticalOptions="Center">
                                                <BoxView HeightRequest="1.5" VerticalOptions="Center"
                                                         Color="{AppThemeBinding Light={StaticResource LightBorder},
                                                                                  Dark={StaticResource DarkBorder}}" />
                                                <Border WidthRequest="22" HeightRequest="22"
                                                        StrokeShape="Ellipse" StrokeThickness="1.5"
                                                        Stroke="{AppThemeBinding Light={StaticResource LightBorder},
                                                                                  Dark={StaticResource DarkBorder}}"
                                                        BackgroundColor="{AppThemeBinding Light={StaticResource LightCard},
                                                                                           Dark={StaticResource DarkCard}}"
                                                        HorizontalOptions="Center">
                                                    <Label Text="+" FontSize="13" FontAttributes="Bold"
                                                           TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary},
                                                                                       Dark={StaticResource DarkTextSecondary}}"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center" />
                                                </Border>
                                            </Grid>

                                            <Label Grid.Column="3"
                                                   Text="{Binding SecondColorRatio, StringFormat='{0:P0}'}"
                                                   FontSize="13" FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary},
                                                                               Dark={StaticResource DarkTextPrimary}}"
                                                   VerticalOptions="Center"
                                                   HorizontalOptions="End" />

                                            <Border Grid.Column="4"
                                                    WidthRequest="44" HeightRequest="44"
                                                    StrokeShape="RoundRectangle 10"
                                                    StrokeThickness="2"
                                                    Stroke="{AppThemeBinding Light={StaticResource LightBorder},
                                                                              Dark={StaticResource DarkBorder}}"
                                                    BackgroundColor="{Binding SecondColor.ToColor}">
                                                <Border.Shadow>
                                                    <Shadow Brush="{Binding SecondColor.ToColor}"
                                                            Opacity="0.25" Radius="6" Offset="0,2" />
                                                </Border.Shadow>
                                            </Border>

                                        </Grid>

                                        <!-- Result color bar -->
                                        <Border HeightRequest="36"
                                                StrokeShape="RoundRectangle 10"
                                                StrokeThickness="0"
                                                BackgroundColor="{Binding ResultColor.ToColor}"
                                                HorizontalOptions="Fill">
                                            <Border.Shadow>
                                                <Shadow Brush="{Binding ResultColor.ToColor}"
                                                        Opacity="0.35" Radius="10" Offset="0,3" />
                                            </Border.Shadow>
                                            <Label Text="{Binding ResultColor.Hex}"
                                                   FontSize="12" FontFamily="Monospace"
                                                   FontAttributes="Bold" TextColor="White"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"
                                                   Opacity="0.9" />
                                        </Border>

                                        <!-- Accuracy -->
                                        <Label Text="{Binding Accuracy,
                                                      StringFormat='Accuracy  {0:P1}'}"
                                               FontSize="12" FontAttributes="Bold"
                                               TextColor="{StaticResource Accent}"
                                               HorizontalOptions="Center" />

                                    </VerticalStackLayout>
                                </Border>

                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </ScrollView>

            </Grid>

        </VerticalStackLayout>
    </Border>
</ContentView>