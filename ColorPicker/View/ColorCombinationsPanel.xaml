<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ColorPicker.ViewModels"
             xmlns:m="clr-namespace:ColorPicker.Models.Colors"
             xmlns:c="clr-namespace:ColorPicker.Services.Converters"
             x:Class="ColorPicker.View.ColorCombinationsPanel"
             x:DataType="vm:ColorCombinationsPanelViewModel"
             VerticalOptions="End">

    <ContentView.Resources>
        <c:RouteToColorConverter x:Key="InverseBoolConverter" />
        <!--<x:Double x:Key="PeekHeight">108</x:Double>-->
        <x:Double x:Key="ChipSize">56</x:Double>
    </ContentView.Resources>

    <!-- Panel surface -->
    <Border BackgroundColor="{AppThemeBinding Light={StaticResource LightCard}, Dark={StaticResource DarkCard}}"
            StrokeThickness="1"
            Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"
            StrokeShape="RoundRectangle 24,24,0,0">
        <Border.Shadow>
            <Shadow Brush="Black" Opacity="0.14" Radius="20" Offset="0,-6" />
        </Border.Shadow>

        <Grid RowDefinitions="Auto,Auto,*">

            <!-- Drag handle -->
            <VerticalStackLayout Grid.Row="0" Spacing="0" Padding="0,12,0,8">
                <VerticalStackLayout.GestureRecognizers>
                    <!-- Toggle on tap; code-behind / Behavior animates HeightRequest -->
                    <TapGestureRecognizer Command="{Binding ToggleExpandCommand}" />
                    <!-- PanGestureRecognizer hooked in code-behind for smooth drag -->
                </VerticalStackLayout.GestureRecognizers>

                <!-- Pill handle -->
                <BoxView WidthRequest="40" HeightRequest="4"
                         CornerRadius="2"
                         Color="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"
                         HorizontalOptions="Center" />

                <!-- Section title -->
                <Label Text="Color Combinations"
                       FontAttributes="Bold" FontSize="14"
                       Margin="20,10,20,0"
                       TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary},
                                                   Dark={StaticResource DarkTextPrimary}}" />
            </VerticalStackLayout>

            <!-- Source color + summary row (always visible in peek) -->
            <Grid Grid.Row="1"
                  ColumnDefinitions="52,*"
                  ColumnSpacing="12"
                  Padding="20,4,20,12">

                <!-- Source swatch -->
                <Border Grid.Column="0"
                        WidthRequest="48" HeightRequest="48"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="2"
                        Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"
                        BackgroundColor="{Binding SourceColor}" />

                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                    <Label Text="Selected Color"
                           Style="{StaticResource BodyLabelStyle}"
                           FontSize="11" />
                    <Label Text="Drag up to explore combinations"
                           FontAttributes="Bold" FontSize="12"
                           TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary},
                                                       Dark={StaticResource DarkTextPrimary}}" />
                </VerticalStackLayout>
            </Grid>

            <!-- Combination chips -->
            <!--
                Shown horizontally in peek mode (one row scrollable left-right).
                When IsExpanded the parent can switch this to a vertical grouped list.
                Grouping labels (Complementary, Analogous, Triadic) appear as section headers.
            -->
            <ScrollView Grid.Row="2"
                        Orientation="Horizontal"
                        IsVisible="{Binding IsExpanded, Converter={StaticResource InverseBoolConverter}}"
                        Padding="20,0,20,20">
                <BindableLayout.ItemsSource>
                    <Binding Path="Combinations" />
                </BindableLayout.ItemsSource>
                <HorizontalStackLayout Spacing="12"
                                       BindableLayout.ItemsSource="{Binding Combinations}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="m:ColorCombination">
                            <VerticalStackLayout Spacing="6" WidthRequest="{StaticResource ChipSize}">
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ColorCombinationsPanelViewModel}},
                                                          Path=SelectChipCommand}"
                                        CommandParameter="{Binding .}" />
                                </VerticalStackLayout.GestureRecognizers>

                                <Border WidthRequest="{StaticResource ChipSize}"
                                        HeightRequest="{StaticResource ChipSize}"
                                        StrokeShape="RoundRectangle 14"
                                        StrokeThickness="2"
                                        Stroke="{AppThemeBinding Light={StaticResource LightBorder},
                                                                  Dark={StaticResource DarkBorder}}"
                                        BackgroundColor="{Binding FirstColor}">
                                    <Border.Shadow>
                                        <Shadow Brush="Black" Opacity="0.10"
                                                Radius="6" Offset="0,2" />
                                    </Border.Shadow>
                                </Border>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </ScrollView>

            <!-- Expanded grouped view -->
            <!--
                Visible only when IsExpanded = true.
                Groups Chips by GroupName so each harmony type has its own header row.
            -->
            <CollectionView Grid.Row="2"
                            ItemsSource="{Binding Combinations}"
                            IsVisible="{Binding IsExpanded}"
                            Margin="0,0,0,20">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="m:ColorCombination">
                        <Grid ColumnDefinitions="52,*,Auto"
                              ColumnSpacing="14"
                              Padding="20,6">
                            <Border Grid.Column="0"
                                    WidthRequest="48" HeightRequest="48"
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="0"
                                    BackgroundColor="{Binding FirstColor}" />

                            <Button Grid.Column="2"
                                    Text="Use"
                                    Style="{StaticResource OutlineButtonStyle}"
                                    WidthRequest="64"
                                    HeightRequest="36"
                                    FontSize="12"
                                    VerticalOptions="Center"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ColorCombinationsPanelViewModel}},
                                                      Path=SelectChipCommand}"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </Grid>
    </Border>
</ContentView>
