<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:ColorPicker.Services.Converters"
             x:Class="ColorPicker.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converters:RouteMatchConverter x:Key="RouteMatchConverter" />
            <converters:RouteToColorConverter x:Key="RouteToColorConverter" />
            <converters:BoolToChevronConverter x:Key="BoolToChevronConverter" />
            <converters:StringNotEmptyConverter x:Key="StringNotEmptyConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
